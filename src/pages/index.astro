---
import "../styles/style.css"; // Zorg dat dit pad klopt!

const token = import.meta.env.TMDB_TOKEN;
// Het 'now_playing' endpoint voor recente films
const url = 'https://api.themoviedb.org/3/movie/now_playing?language=nl-NL&page=1';

const options = {
    method: 'GET',
    headers: {
        accept: 'application/json',
        Authorization: `Bearer ${token}`
    }
};

const response = await fetch(url, options);
const data = await response.json();

// De array met 20 films zit in 'data.results'
const movies = data.results; 
---

<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nieuwste Films - Overzicht</title>
</head>
<body>
    <main>
        <h1 class="hoofdtitel">Nu in de Bioscoop</h1>

        {/* De grid waar alle films in komen */}
        <div class="movie-grid">
            
            {/* We 'loopen' over elke film en maken er een klikbaar kaartje van */}
            {movies.map((movie: any) => (
                
                // De link gaat naar /movie/ID_VAN_DE_FILM
                <a href={`/movie/${movie.id}`} class="overzicht-kaart">
                    <img 
                        src={`https://image.tmdb.org/t/p/w500${movie.poster_path}`} 
                        alt={movie.title} 
                        class="overzicht-poster"
                    />
                    <h2 class="overzicht-titel">{movie.title}</h2>
                </a>

            ))}

        </div>
    </main>
</body>
</html>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #121212;
        color: white;
        margin: 0;
        padding: 40px 20px;
    }

    main {
        max-width: 1200px;
        margin: 0 auto; /* Zet alles netjes in het midden */
    }

    .hoofdtitel {
        text-align: center;
        color: #e50914;
        margin-bottom: 40px;
        font-size: 3rem;
    }

    /* CSS Grid zorgt voor mooie kolommen die automatisch schalen */
    
    .movie-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 30px;
    }

    /* Het klikbare kaartje */
    .overzicht-kaart {
        text-decoration: none; /* Haalt het standaard blauwe link-streepje weg */
        color: white;
        background-color: #1e1e1e;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s; /* Voor een soepele zweef-animatie */
        box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }

    .overzicht-kaart:hover {
        transform: scale(1.05); /* Maakt het kaartje iets groter als je erover zweeft */
    }

    .overzicht-poster {
        width: 100%;
        height: auto;
        display: block;
    }

    .overzicht-titel {
        font-size: 1.1rem;
        text-align: center;
        padding: 15px 10px;
        margin: 0;
    }
</style>