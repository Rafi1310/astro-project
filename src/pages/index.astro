---
import { ClientRouter } from 'astro:transitions';
import "../styles/style.css"; // Zorg dat dit pad klopt!

const token = import.meta.env.TMDB_TOKEN;
// Het 'now_playing' endpoint voor recente films


const options = {
    method: 'GET',
    headers: {
        accept: 'application/json',
        Authorization: `Bearer ${token}`
    }
};

// Vraag Pagina 1 op
const urlPage1 = 'https://api.themoviedb.org/3/movie/now_playing?language=nl-NL&page=1';
const response1 = await fetch(urlPage1, options);
const data1 = await response1.json();

// Vraag Pagina 2 op
const urlPage2 = 'https://api.themoviedb.org/3/movie/now_playing?language=nl-NL&page=2';
const response2 = await fetch(urlPage2, options);
const data2 = await response2.json();

// Plak de twee lijstjes aan elkaar vast! 
// De drie puntjes (...) heten de 'spread operator' en halen de films uit hun lijstje om ze samen in één grote nieuwe lijst te stoppen.
const movies = [...data1.results, ...data2.results];
---

<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nieuwste Films - Overzicht</title>
	<ClientRouter />
</head>
<body>
    <main>
        <h1 class="hoofdtitel">Nu in de Bioscoop</h1>

        {/* De grid waar alle films in komen */}
        <div class="movie-grid">
            
            {/* We 'loopen' over elke film en maken er een klikbaar kaartje van */}
            {movies.map((movie: any) => (
                
                // De link gaat naar /movie/ID_VAN_DE_FILM
                <a href={`/movie/${movie.id}`} class="overzicht-kaart">
                    <img 
                        src={`https://image.tmdb.org/t/p/w500${movie.poster_path}`} 
                        alt={movie.title} 
                        class="overzicht-poster"
						transition:name={`poster-${movie.id}`}
                    />
                    <h2 class="overzicht-titel">{movie.title}</h2>
                </a>

            ))}

        </div>
    </main>
</body>
</html>

